<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_reclassification_list" model="ir.ui.view">
        <field name="name">stock.reclassification.list</field>
        <field name="model">stock.reclassification</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'">
                <field name="name" />
                <field name="date" />
                <field name="rule_id" />
                <field name="location_src_id" />
                <field name="location_dest_id" />
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_stock_reclassification_search" model="ir.ui.view">
        <field name="name">stock.reclassification.search</field>
        <field name="model">stock.reclassification</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="rule_id" />
                <field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]" />
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
                <group>
                    <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}" />
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_stock_reclassification_form" model="ir.ui.view">
        <field name="name">stock.reclassification.form</field>
        <field name="model">stock.reclassification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" string="Validate" type="object" class="btn-primary" invisible="state != 'draft'" />
                    <button name="action_cancel" string="Reverse" type="object" invisible="state != 'done'" confirm="Reverse the reclassification? The goods go back to the source location and a reversal entry is posted." />
                    <field name="state" widget="statusbar" statusbar_visible="draft,done" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'" />
                            <field name="date" readonly="state != 'draft'" />
                            <field name="rule_id" readonly="state != 'draft'" options="{'no_create': True}" />
                            <field name="account_src_id" />
                            <field name="account_dest_id" />
                            <field name="destination_type" invisible="1" />
                            <field name="require_decision" invisible="1" />
                            <field name="require_reason" invisible="1" />
                        </group>
                        <group>
                            <field name="location_src_id" readonly="state != 'draft'" options="{'no_create': True}" />
                            <field name="location_dest_id" readonly="state != 'draft'" options="{'no_create': True}" />
                            <field name="journal_id" readonly="state != 'draft'" options="{'no_create': True}" />
                            <field name="picking_id" invisible="not picking_id" />
                            <field name="account_move_id" invisible="not account_move_id" />
                            <field name="reverse_picking_id" invisible="not reverse_picking_id" />
                            <field name="reverse_account_move_id" invisible="not reverse_account_move_id" />
                        </group>
                    </group>
                    <group>
                        <field name="decision_note" readonly="state != 'draft'" required="require_decision" />
                        <field name="reason" readonly="state != 'draft'" required="require_reason" />
                    </group>
                    <notebook>
                        <page string="Products" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id" />
                                    <field name="tracking" column_invisible="True" />
                                    <field name="lot_id" required="tracking != 'none'" readonly="tracking == 'none'" />
                                    <field name="quantity" />
                                    <field name="product_uom_id" />
                                    <field name="invoice_line_id" optional="show" />
                                    <field name="unit_cost" optional="show" column_invisible="parent.state == 'draft'" />
                                    <field name="value" optional="show" column_invisible="parent.state == 'draft'" />
                                    <field name="currency_id" column_invisible="True" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_stock_reclassification" model="ir.actions.act_window">
        <field name="name">Stock Reclassifications</field>
        <field name="res_model">stock.reclassification</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
