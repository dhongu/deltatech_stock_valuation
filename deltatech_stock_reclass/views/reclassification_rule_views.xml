<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_reclassification_rule_list" model="ir.ui.view">
        <field name="name">stock.reclassification.rule.list</field>
        <field name="model">stock.reclassification.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="account_src_id" />
                <field name="account_dest_id" />
                <field name="destination_type" />
                <field name="require_decision" />
                <field name="require_reason" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_stock_reclassification_rule_form" model="ir.ui.view">
        <field name="name">stock.reclassification.rule.form</field>
        <field name="model">stock.reclassification.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="account_src_id" domain="[('company_ids', 'parent_of', company_id)]" />
                            <field name="account_dest_id" domain="[('company_ids', 'parent_of', company_id)]" />
                            <field name="destination_type" />
                        </group>
                        <group>
                            <field name="require_decision" />
                            <field name="require_reason" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_reclassification_rule" model="ir.actions.act_window">
        <field name="name">Reclassification Rules</field>
        <field name="res_model">stock.reclassification.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
