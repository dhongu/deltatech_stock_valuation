<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="privilege_stock_reclassification" model="res.groups.privilege">
        <field name="name">Stock Reclassification</field>
        <field name="category_id" ref="base.module_category_supply_chain" />
    </record>

    <record id="rule_stock_reclassification_company" model="ir.rule">
        <field name="name">Stock reclassification: multi-company</field>
        <field name="model_id" ref="model_stock_reclassification" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_stock_reclassification_line_company" model="ir.rule">
        <field name="name">Stock reclassification line: multi-company</field>
        <field name="model_id" ref="model_stock_reclassification_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_stock_reclassification_rule_company" model="ir.rule">
        <field name="name">Stock reclassification rule: multi-company</field>
        <field name="model_id" ref="model_stock_reclassification_rule" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <data noupdate="1">
        <record id="group_stock_reclassification_user" model="res.groups">
            <field name="name">Reclassifications</field>
            <field name="privilege_id" ref="privilege_stock_reclassification" />
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]" />
        </record>
        <record id="group_stock_reclassification_manager" model="res.groups">
            <field name="name">Reclassification Configuration</field>
            <field name="privilege_id" ref="privilege_stock_reclassification" />
            <field name="implied_ids" eval="[(4, ref('group_stock_reclassification_user'))]" />
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        </record>
    </data>
</odoo>
