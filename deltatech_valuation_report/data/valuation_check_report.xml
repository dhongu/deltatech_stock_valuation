<odoo>

    <record id="valuation_check_report" model="account.report">
        <field name="name">Stock Valuation vs Balance Check</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">this_month</field>
        <field name="custom_handler_model_id" ref="model_valuation_check_report_handler"/>

        <field name="column_ids">
            <record id="col_balance" model="account.report.column">
                <field name="name">Account Balance</field>
                <field name="expression_label">balance</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">10</field>
            </record>
            <record id="col_valuation" model="account.report.column">
                <field name="name">Valuation (lines with product)</field>
                <field name="expression_label">valuation</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">20</field>
            </record>
            <record id="col_difference" model="account.report.column">
                <field name="name">Difference (lines without product)</field>
                <field name="expression_label">difference</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">30</field>
            </record>
        </field>

        <field name="line_ids">
            <record id="line_accounts" model="account.report.line">
                <field name="name">Stock valuation accounts</field>
                <field name="groupby">account_id</field>
                <field name="user_groupby">account_id</field>
                <field name="expression_ids">
                    <record id="expr_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_custom_engine_valuation_check</field>
                        <field name="subformula">balance</field>
                        <field name="figure_type">monetary</field>
                    </record>
                    <record id="expr_valuation" model="account.report.expression">
                        <field name="label">valuation</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_custom_engine_valuation_check</field>
                        <field name="subformula">valuation</field>
                        <field name="figure_type">monetary</field>
                    </record>
                    <record id="expr_difference" model="account.report.expression">
                        <field name="label">difference</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_custom_engine_valuation_check</field>
                        <field name="subformula">difference</field>
                        <field name="figure_type">monetary</field>
                    </record>
                </field>
            </record>
        </field>
    </record>

    <record id="action_valuation_check_report" model="ir.actions.client">
        <field name="name">Stock Valuation vs Balance Check</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('valuation_check_report')}"/>
    </record>

    <menuitem id="menu_valuation_check_report"
              name="Stock Valuation Check"
              parent="account.menu_finance_reports"
              action="action_valuation_check_report"
              sequence="110"/>

</odoo>
