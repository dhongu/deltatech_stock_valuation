<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_test_run_form" model="ir.ui.view">
        <field name="name">stock.test.run.form</field>
        <field name="model">stock.test.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="running,passed,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="scenario_id"/>
                            <field name="mode"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Step Logs">
                            <field name="log_ids" readonly="1">
                                <list decoration-danger="state == 'error'"
                                      decoration-success="state == 'ok'"
                                      decoration-info="state == 'info'"
                                      open_form_view="False">
                                    <field name="step_index" string="#"/>
                                    <field name="step_type"/>
                                    <field name="state"/>
                                    <field name="message"/>
                                    <field name="document_ref" string="Document"/>
                                    <field name="document_model" string="Model" optional="hide"/>
                                    <button name="action_open_document" string="Open" type="object"
                                            icon="fa-external-link"
                                            invisible="not document_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Execution Log">
                            <field name="log_html" readonly="1" widget="html" options="{'css_read_only': 'o_markdown_style'}"/>
                        </page>
                        <page string="Accounting Lines">
                            <field name="account_move_line_ids" readonly="1">
                                <list>
                                    <field name="move_id" string="Entry"/>
                                    <field name="account_id"/>
                                    <field name="name"/>
                                    <field name="debit"/>
                                    <field name="credit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_stock_test_run_list" model="ir.ui.view">
        <field name="name">stock.test.run.list</field>
        <field name="model">stock.test.run</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'passed'"
                  decoration-danger="state == 'failed'"
                  decoration-info="state == 'running'">
                <field name="name"/>
                <field name="scenario_id"/>
                <field name="mode"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="action_stock_test_run" model="ir.actions.act_window">
        <field name="name">Test Runs</field>
        <field name="res_model">stock.test.run</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
