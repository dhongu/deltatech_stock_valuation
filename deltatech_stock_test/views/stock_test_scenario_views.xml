<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_test_scenario_form" model="ir.ui.view">
        <field name="name">stock.test.scenario.form</field>
        <field name="model">stock.test.scenario</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_ready" string="Set Ready" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_execute" string="Run Scenario" type="object"
                            class="btn-primary"
                            invisible="state not in ('ready', 'failed')"/>
                    <button name="action_execute" string="Re-run Scenario" type="object"
                            invisible="state != 'executed'"/>

                    <button name="action_export_json" string="Export JSON" type="object"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ready,executed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_runs" type="object" class="oe_stat_button"
                                icon="fa-list">
                            <field name="run_count" widget="statinfo" string="Runs"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="mode"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scenario JSON">
                            <field name="json_data" widget="ace"
                                   options="{'mode': 'json'}"
                                   placeholder='{"name": "...", "lines": [], "expected_account_moves": []}'/>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Last Error" invisible="not last_error">
                            <field name="last_error" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_stock_test_scenario_list" model="ir.ui.view">
        <field name="name">stock.test.scenario.list</field>
        <field name="model">stock.test.scenario</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'executed'"
                  decoration-danger="state == 'failed'"
                  decoration-info="state == 'ready'"
                  decoration-muted="state == 'draft'">
                <header>
                    <button name="action_execute_selected" string="Run Selected" type="object"
                            class="btn-primary"/>
                    <button name="action_open_import_wizard" string="Import Scenarios" type="object"
                            class="btn-secondary" display="always"/>
                </header>
                <field name="name"/>
                <field name="mode"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
                <field name="run_count"/>
            </list>
        </field>
    </record>

    <record id="action_stock_test_scenario" model="ir.actions.act_window">
        <field name="name">Test Scenarios</field>
        <field name="res_model">stock.test.scenario</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_server_reload_demo_scenarios" model="ir.actions.server">
        <field name="name">Reload Demo Scenarios</field>
        <field name="model_id" ref="model_stock_test_scenario"/>
        <field name="binding_model_id" ref="model_stock_test_scenario"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">model.load_demo_scenarios()</field>
    </record>
</odoo>
