<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_test_scenario_import_wizard" model="ir.ui.view">
        <field name="name">stock.test.scenario.import.wizard.form</field>
        <field name="model">stock.test.scenario.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import JSON Scenarios">
                <field name="attachment_ids" widget="many2many_binary"/>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_test_scenario_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Scenarios</field>
        <field name="res_model">stock.test.scenario.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
