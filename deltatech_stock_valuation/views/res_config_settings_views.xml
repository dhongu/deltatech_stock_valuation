<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50" />
        <field name="inherit_id" ref="stock_account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='valuation_setting_container']" position="inside">
                <setting
                    title="Set the valuation area level and the valuation area for the company."
                    id="module_deltatech_stock_valuation"
                >
                    <field name="module_deltatech_stock_valuation" />

                    <div class="row mt16">
                        <label for="valuation_area_level" class="col-lg-4 o_light_label" />
                        <field name="valuation_area_level" />
                    </div>
                    <div class="row mt16">
                        <label for="valuation_area_id" class="col-lg-4 o_light_label" />
                        <field name="valuation_area_id" />
                    </div>
                </setting>
                <setting
                    title="Refresh valuation."
                    id="compute_deltatech_stock_valuation"
                    invisible="valuation_area_level != 'company'"
                >
                    <field name="is_refresh_running" invisible="1" />

                    <!-- One-click background recompute: runs all 7 steps automatically -->
                    <div class="row mt16" invisible="valuation_area_level != 'company'">
                        <div class="col-lg-12">
                            <button
                                type="object"
                                name="action_recompute_in_background"
                                icon="fa-rocket"
                                string="Recompute All (Background)"
                                class="btn-primary me-2"
                                invisible="is_refresh_running"
                                confirm="This will rebuild the whole stock valuation history in the background. Continue?"
                            />
                            <button
                                type="object"
                                name="stop_auto_refresh"
                                icon="fa-stop-circle"
                                string="Stop Background Refresh"
                                class="btn-danger me-2"
                                invisible="not is_refresh_running"
                            />
                            <span class="badge text-bg-info" invisible="not is_refresh_running">Running…</span>
                        </div>
                    </div>

                    <div class="row mt8" invisible="valuation_area_level != 'company'">
                        <div class="col-lg-12">
                            <span class="o_light_label me-2">Next step:</span>
                            <field name="refresh_valuation_step_info" readonly="1" class="fw-bold" />
                        </div>
                    </div>
                    <div class="row" invisible="valuation_area_level != 'company'">
                        <div class="col-lg-12 text-muted">
                            <field name="refresh_valuation_progress_info" readonly="1" />
                        </div>
                    </div>

         <!--           &lt;!&ndash; Manual stepping (advanced / debugging) &ndash;&gt;
                    <div class="row mt16" invisible="valuation_area_level != 'company'">
                        <div class="col-lg-12">
                            <span class="o_light_label me-2">Manual (advanced):</span>
                            <button
                                type="object"
                                name="refresh_stock_valuation"
                                icon="fa-play"
                                string="Execute Next Step"
                                class="btn-secondary me-2"
                            />
                            <button
                                type="object"
                                name="reset_refresh_valuation_step"
                                icon="fa-undo"
                                string="Reset to Step 1"
                                class="btn-secondary me-2"
                            />
                            <button
                                type="object"
                                name="recompute_product_valuation"
                                icon="fa-calculator"
                                string="Recompute Product Valuation"
                                class="btn-link"
                            />
                        </div>
                    </div>-->
                </setting>

            </xpath>
        </field>
    </record>
</odoo>
