<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Extinde vizualizarea formularului pentru product.template -->
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']//group[@name='accounting']" position="inside">
                <!-- doar citire: rândurile se reconstruiesc din notele contabile la recalculul complet -->
                <field name="product_valuation_ids" nolabel="1" readonly="1">
                    <list create="0" delete="0">
                        <field name="product_id" />
                        <field name="valuation_area_id" />
                        <field name="account_id" />
                        <field name="price" />
                        <field name="quantity" sum="sum_qty" />
                        <field name="amount" sum="sum_amount" />
                        <field name="currency_id" column_invisible="1" />
                    </list>
                </field>

            </xpath>
        </field>
    </record>



</odoo>
