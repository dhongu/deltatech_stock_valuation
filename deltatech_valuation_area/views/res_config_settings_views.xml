<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock_account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='valuation_setting_container']" position="inside">
                <setting id="valuation_area" title="Set valuation area for the company.">
                    <field name="use_valuation_area" />
                    <div class="text-muted">
                        Use valuation area for this company.
                    </div>
                    <div class="content-group" invisible="not use_valuation_area">
                        <div class="row mt16">
                            <label for="valuation_area_id" class="col-lg-4 o_light_label" />
                            <field name="valuation_area_id" class="col-lg-8" />
                        </div>
                    </div>
                </setting>
                <setting
                    id="valuation_keep_move_value"
                    help="Checked: validated stock moves keep the value computed at validation (as in Odoo 19), consistent with the posted journal entries. Unchecked: the standard Odoo 20 recompute rewrites the value of later outgoing moves, but posted journal entries are NOT corrected, so stock value and accounting can diverge."
                >
                    <field name="valuation_keep_move_value" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
