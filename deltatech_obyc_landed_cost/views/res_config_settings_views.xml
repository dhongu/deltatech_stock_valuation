<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.deltatech_obyc_landed_cost</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock_account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='valuation_setting_container']" position="inside">
                <setting
                    id="landed_cost_method"
                    string="Landed Cost Class 6 Method"
                    help="How a landed cost entry that would credit a class 6 (expense) account is generated. 'Through intermediary account' routes the class 6 credit through a technical account, producing two balanced entries with the same net effect."
                >
                    <field name="landed_cost_method" />
                    <div class="content-group mt16" invisible="landed_cost_method != 'intermediary'">
                        <label for="landed_cost_intermediary_account_id" string="Intermediary Account" />
                        <field
                            name="landed_cost_intermediary_account_id"
                            required="landed_cost_method == 'intermediary'"
                        />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
