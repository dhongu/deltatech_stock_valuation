<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_scenario_import_wizard" model="ir.ui.view">
        <field name="name">account.scenario.import.wizard.form</field>
        <field name="model">account.scenario.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import JSON Scenarios">
                <field name="attachment_ids" widget="many2many_binary" options="{'accepted_file_extensions': '.json'}"/>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_scenario_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Scenarios</field>
        <field name="res_model">account.scenario.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
